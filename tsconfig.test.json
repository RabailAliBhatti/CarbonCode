{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "types": ["vitest/globals", "node"],
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src/__tests__"],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
