{
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "lib": ["ES2020"],
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "vite.config.ts",
        "electron/**/*.ts",
        "src/__tests__/**/*.ts"
    ]
}